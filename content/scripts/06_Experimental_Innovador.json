 "captions": [
  {
   "start": 0.0,
   "end": 2.04,
   "text": "Sistema de vuelo: *activado*."
  },
  {
   "start": 2.04,
   "end": 5.82,
   "text": "Ruta: Madrid → Los Ángeles. Altitud: *11.000 m*."
  },
  {
   "start": 5.82,
   "end": 7.86,
   "text": "Temperatura exterior: *−56 °C*."
  },
  {
   "start": 7.86,
   "end": 10.77,
   "text": "Descenso: 6,5 °C por kilómetro."
  },
  {
   "start": 10.77,
   "end": 12.8,
   "text": "Densidad del aire: *30 %*."
  },
  {
   "start": 12.8,
   "end": 14.84,
   "text": "Resistencia mínima. Consumo: *optimizado*."
  },
  {
   "start": 14.84,
   "end": 18.62,
   "text": "Presión de cabina: equivalente a *2.400 m*."
  },
  {
   "start": 18.62,
   "end": 20.66,
   "text": "Pasajeros: sin cambios aparentes."
  },
  {
   "start": 20.66,
   "end": 24.44,
   "text": "Aviso: bolsa de patatas *hinchada*. Causa: baja presión."
  },
  {
   "start": 24.44,
   "end": 27.78,
   "text": "Ventanilla: 3 capas. Orificio de presión: *activo*."
  },
  {
   "start": 27.78,
   "end": 31.56,
   "text": "Historial, 1954: fallos por fatiga en aviones Comet."
  },
  {
   "start": 31.56,
   "end": 33.17,
   "text": "Solución: *esquinas redondas*."
  },
  {
   "start": 33.17,
   "end": 36.51,
   "text": "Calculando ruta… Resultado: *curva hacia el norte*."
  },
  {
   "start": 36.51,
   "end": 40.72,
   "text": "Motivo: la Tierra es una esfera. Ahorro: *790 km*."
  },
  {
   "start": 40.72,
   "end": 42.76,
   "text": "Analizando proyección del mapa…"
  },
  {
   "start": 42.76,
   "end": 45.67,
   "text": "Error detectado en el mapa plano."
  },
  {
   "start": 45.67,
   "end": 49.45,
   "text": "Groenlandia: tamaño real, *14 veces* menor que África."
  },
  {
   "start": 49.45,
   "end": 56.27,
   "text": "Registro de 2020: un 747 de Nueva York a Londres en *4 h 56 min*."
  },
  {
   "start": 56.27,
   "end": 60.48,
   "text": "Velocidad respecto al suelo: casi *1.300 km/h*."
  },
  {
   "start": 60.48,
   "end": 62.96,
   "text": "Causa: la corriente en chorro."
  },
  {
   "start": 62.96,
   "end": 65.87,
   "text": "Distancia: 9.363 km. Aterrizaje: *completado*."
  },
  {
   "start": 65.87,
   "end": 69.21,
   "text": "Fin de la transmisión. ¿Sigues ahí? *Sígueme*."
  }
 ],
